# PMTiles Base URL (optional)
# The manifest (year → hashed filename) is embedded at build time via @world-history-map/tiles.
# This variable controls only where the PMTiles binary files are fetched from.
#
# Leave empty (default) in every environment: tiles are fetched same-origin from /pmtiles/,
# served by the Vite dev middleware in dev and by the Pages Function (apps/worker) on Cloudflare.
# Set it only to point at a different tiles origin.
VITE_TILES_BASE_URL=
